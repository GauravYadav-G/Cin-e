# Local preview uses SQLite unless DATABASE_URL is set.
DATABASE_URL=
ALLOW_SQLITE_PREVIEW=true

# Only per-film magnet sources are streamed. No sample or external-video fallback.
# Map multiple films in .data/stream-sources.json (see config/stream-sources.example.json).
STREAM_SOURCES_FILE=.data/stream-sources.json

# Optional single-film configuration; BOTH fields are required.
STREAM_FILM_ID=
STREAM_URL=
STREAM_TRANSCODE=false
# Alternatively: MAGNET_YOUR_FILM_ID=magnet:?xt=urn:btih:...

# Run npm run dev:all, or npm run dev and npm run stream separately.
TORRENT_STREAM_URL=http://127.0.0.1:8899
TORRENT_STREAM_PORT=8899
# FFmpeg is required for MKV/AVI/MOV/TS or transcode:true sources.
FFMPEG_PATH=ffmpeg
