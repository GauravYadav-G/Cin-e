# Optional locally. Without DATABASE_URL, a persistent SQLite database is used.
# Set this to your managed PostgreSQL connection string in production.
DATABASE_URL=
# Required to deliberately use SQLite in a production build/local preview.
ALLOW_SQLITE_PREVIEW=true
# Optional: URL to your licensed MP4 or HLS (.m3u8) stream.
# With no stream configured, playback uses the clearly labelled demo film.
STREAM_URL=
